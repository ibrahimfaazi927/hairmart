generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Admin / Staff Users ───────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("admin") // admin | staff
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Customers (CRM) ──────────────────────────────────────
model Customer {
  id            String    @id @default(cuid())
  name          String
  phone         String    @unique
  whatsapp      String?
  email         String?
  notes         String?
  status        String    @default("active") // active | inactive | vip
  lastVisit     DateTime?
  nextFollowUp  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[]
  reviews       Review[]
  payments      Payment[]
  invoices      Invoice[]
}

// ─── Chair Management ─────────────────────────────────────
model Chair {
  id            String    @id @default(cuid())
  name          String    // e.g. "Chair 1", "Chair 2", etc.
  section       String    // "men" | "women"
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedStaff Staff?
  appointments  Appointment[]
}

// ─── Staff Management ─────────────────────────────────────
model Staff {
  id            String    @id @default(cuid())
  name          String
  phone         String?
  gender        String?   // male | female | other
  role          String    // Hair Stylist | Barber | Beautician | Spa Therapist | Receptionist | Senior Stylist
  section       String?   // men | women | unisex
  chairId       String?   @unique
  joiningDate   DateTime? @default(now())
  status        String    @default("active")  // active | inactive
  notes         String?
  avatar        String?
  specialties   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chair               Chair?                @relation(fields: [chairId], references: [id])
  attendances         StaffAttendance[]
  leaves              StaffLeave[]
  appointmentServices AppointmentService[]
}

// ─── Staff Attendance ─────────────────────────────────────
model StaffAttendance {
  id            String    @id @default(cuid())
  staffId       String
  date          DateTime  // Date of attendance (day, normalized UTC 00:00:00)
  checkIn       String?   // e.g. "09:05 AM"
  checkOut      String?   // e.g. "07:10 PM"
  duration      String?   // e.g. "8 hrs 15 mins"
  status        String    @default("Present") // Present | Absent | Half Day | Leave | Holiday
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

// ─── Staff Leave ──────────────────────────────────────────
model StaffLeave {
  id            String    @id @default(cuid())
  staffId       String
  startDate     DateTime
  endDate       DateTime
  leaveType     String    @default("Casual") // Casual | Sick | Paid | Unpaid | Emergency
  status        String    @default("approved") // approved | pending | rejected
  reason        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

// ─── Service Categories ────────────────────────────────────
model ServiceCategory {
  id            String    @id @default(cuid())
  name          String    // e.g. "Hair Spa", "Hair Cut", "Hair Colouring", "Hair Forms"
  gender        String    // women | men | unisex
  description   String?
  sortOrder     Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  services      Service[]
}

// ─── Services ──────────────────────────────────────────────
model Service {
  id              String    @id @default(cuid())
  name            String
  description     String?
  duration        Int?      // in minutes
  price           Float     @default(0) // internal price for billing
  priceVisible    Boolean   @default(false) // customer-facing price toggle
  image           String?   // image URL / file path for POS cards & catalogue
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  categoryId      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  products        ServiceProduct[]
  packageServices PackageService[]
  appointmentServices AppointmentService[]
}

// ─── Packages ──────────────────────────────────────────────
model Package {
  id            String    @id @default(cuid())
  name          String
  description   String?
  price         Float     @default(0) // internal price for billing
  priceVisible  Boolean   @default(false) // customer-facing price toggle
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  services      PackageService[]
  appointments  Appointment[]
}

// ─── Package ↔ Service (M2M) ──────────────────────────────
model PackageService {
  id          String  @id @default(cuid())
  packageId   String
  serviceId   String

  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
}

// ─── Professional Products ─────────────────────────────────
model Product {
  id            String    @id @default(cuid())
  name          String
  brand         String
  description   String?
  image         String?   // file path or URL
  price         Float     @default(0)
  stock         Int       @default(0)
  category      String?   @default("Hair Care")
  professional  Boolean   @default(true) // professional-use label
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  services      ServiceProduct[]
  appointmentProducts AppointmentProduct[]
}

// ─── Service ↔ Product (M2M) ──────────────────────────────
model ServiceProduct {
  id          String  @id @default(cuid())
  serviceId   String
  productId   String

  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
}

// ─── Appointments ──────────────────────────────────────────
model Appointment {
  id              String    @id @default(cuid())
  customerId      String?
  customerName    String
  customerPhone   String
  customerWhatsapp String?
  customerNote    String?
  date            DateTime
  time            String    // "10:00", "14:30", etc.
  status          String    @default("pending") // pending | confirmed | completed | cancelled | no_show
  packageId       String?
  totalAmount     Float     @default(0)
  chairId         String?
  chairName       String?   // Snapshot: "Chair 1", "Chair 2", etc.
  section         String?   // Snapshot: "men" | "women"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer? @relation(fields: [customerId], references: [id])
  chair           Chair?    @relation(fields: [chairId], references: [id])
  package         Package?  @relation(fields: [packageId], references: [id])
  services        AppointmentService[]
  products        AppointmentProduct[]
  payment         Payment?
  invoice         Invoice?
  followup        Followup?
}

// ─── Appointment ↔ Service (M2M) ──────────────────────────
model AppointmentService {
  id              String  @id @default(cuid())
  appointmentId   String
  serviceId       String
  staffId         String?
  staffName       String?
  quantity        Int     @default(1)
  price           Float   @default(0) // price at time of booking

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id])
  staff           Staff?      @relation(fields: [staffId], references: [id])

  @@unique([appointmentId, serviceId])
}

// ─── Appointment ↔ Product (tracking which product was used) ──
model AppointmentProduct {
  id              String  @id @default(cuid())
  appointmentId   String
  productId       String
  notes           String?

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id])

  @@unique([appointmentId, productId])
}

// ─── Payments ──────────────────────────────────────────────
model Payment {
  id              String    @id @default(cuid())
  appointmentId   String    @unique
  customerId      String?
  amount          Float
  method          String    @default("cash") // cash | card | upi | other | razorpay
  gatewayRef      String?   // payment gateway reference ID
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paymentLinkUrl    String?
  paymentLinkStatus String?   // created | paid | expired
  status          String    @default("pending") // pending | completed | failed | refunded
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
}

// ─── Invoices ──────────────────────────────────────────────
model Invoice {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique
  appointmentId   String    @unique
  customerId      String?
  subtotal        Float     @default(0)
  tax             Float     @default(0)
  discount        Float     @default(0)
  total           Float     @default(0)
  status          String    @default("draft") // draft | sent | paid
  notes           String?
  paymentMethod   String?   @default("cash") // cash | upi | card | other
  chairName       String?
  section         String?
  printReceipt    Boolean   @default(false)
  whatsappStatus  String    @default("not_requested") // not_requested | pending | sent | failed
  itemsJson       String?   // JSON snapshot of billed items with staff attribution for instant receipt generation
  razorpayPaymentLink String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id])
  customer        Customer?   @relation(fields: [customerId], references: [id])
}

// ─── Reviews / Feedback ────────────────────────────────────
model Review {
  id              String    @id @default(cuid())
  customerId      String?
  customerName    String
  serviceName     String?
  rating          Int       // 1-5
  comment         String?
  approved        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer? @relation(fields: [customerId], references: [id])
}

// ─── Gallery ───────────────────────────────────────────────
model GalleryImage {
  id              String    @id @default(cuid())
  title           String?
  category        String    @default("general") // interior | hair | facial | grooming | products | general
  image           String    // file path
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ─── WhatsApp Messages (log) ───────────────────────────────
model WhatsappMessage {
  id              String    @id @default(cuid())
  phone           String
  type            String    // booking_confirmation | reminder | payment_confirmation | bill | thank_you | feedback | followup
  content         String
  status          String    @default("queued") // queued | sent | failed
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
}

// ─── Follow-ups ────────────────────────────────────────────
model Followup {
  id              String    @id @default(cuid())
  appointmentId   String    @unique
  scheduledDate   DateTime
  type            String    @default("reminder") // reminder | feedback | promo
  status          String    @default("pending") // pending | sent | cancelled
  message         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id])
}

// ─── Salon Settings (key-value) ────────────────────────────
model SalonSetting {
  id              String    @id @default(cuid())
  key             String    @unique
  value           String
  group           String    @default("general") // general | contact | website | whatsapp | payment | automation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
